{
  "manifest_version": 1,
  "id": "essentials",
  "name": "Essential CLI Tools",
  "version": "0.6.1",
  "description": "Installs a broad set of workspace CLI tooling and keeps it present across restarts: core networking/utilities (telnet, ping, curl, nc, perl, python, vim, docker), a Node.js dev toolkit (nvm, node, npm, npx, yarn, pnpm), Terraform, and Homebrew (Linuxbrew). Consolidates what used to be four separate apps (essentials, node, terraform, brew) into one, since they're all the same kind of thing: pure command installs, no login/settings/secrets. No config for now.",
  "tier": "inprocess",
  "publisher": "TekFlox",
  "resource_estimate": {
    "cpu": "low",
    "memory": "low",
    "disk": "medium"
  },
  "runtime": {
    "python": ">=3.11",
    "entrypoint": "essentials_app.plugin:EssentialsAppPlugin",
    "pip_requires": []
  },
  "permissions": [
    "commands:install",
    "fs:workspace-data",
    "net:outbound"
  ],
  "contributes": {
    "system_clis": [
      {
        "name": "telnet",
        "installer": "scripts/install_telnet.sh",
        "version": ">=0.17"
      },
      {
        "name": "ping",
        "installer": "scripts/install_ping.sh",
        "version": ">=20210202"
      },
      {
        "name": "curl",
        "installer": "scripts/install_curl.sh",
        "version": ">=7.0"
      },
      {
        "name": "nc",
        "installer": "scripts/install_nc.sh",
        "version": ">=1.10"
      },
      {
        "name": "perl",
        "installer": "scripts/install_perl.sh",
        "version": ">=5.0"
      },
      {
        "name": "python",
        "installer": "scripts/install_python.sh",
        "version": ">=3.9"
      },
      {
        "name": "vim",
        "installer": "scripts/install_vim.sh",
        "version": ">=8.0"
      },
      {
        "name": "docker",
        "installer": "scripts/install_docker.sh",
        "version": ">=24.0"
      },
      {
        "name": "terraform",
        "installer": "scripts/install_terraform.sh"
      },
      {
        "name": "nvm",
        "installer": "scripts/install_nvm.sh",
        "version": ">=0.40"
      },
      {
        "name": "node",
        "installer": "scripts/install_node.sh",
        "version": ">=18"
      },
      {
        "name": "npm",
        "installer": "scripts/install_node.sh",
        "version": ">=9"
      },
      {
        "name": "npx",
        "installer": "scripts/install_node.sh",
        "version": ">=9"
      },
      {
        "name": "yarn",
        "installer": "scripts/install_yarn.sh",
        "version": ">=1.22"
      },
      {
        "name": "pnpm",
        "installer": "scripts/install_pnpm.sh",
        "version": ">=9"
      },
      {
        "name": "brew",
        "installer": "scripts/install_brew.sh"
      }
    ]
  },
  "config_schema": {},
  "dependencies": {},
  "migrations": {}
}
